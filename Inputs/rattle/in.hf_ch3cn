# ------------------------------------------------------------
# LAMMPS input script for DeepMD-based MD simulation
# System: HF + CH3CN
# Ensemble: NVT equilibration at 298.15 K
# ------------------------------------------------------------


# ---------------- Initialization ----------------
units           metal              # Units: metal (ps, Å, eV, GPa, etc.)
dimension       3                  # 3D simulation
boundary        p p p              # Periodic boundaries in x/y/z
atom_style      molecular          # Molecular style (bonds, angles supported)


# ---------------- Force Field Setup ----------------
special_bonds   lj/coul 1.0 1.0 1.0    # Exclude 1-2, 1-3, 1-4 scaling for LJ/Coulomb
bond_style      harmonic               # Harmonic bond potential: E = K(r - r0)^2


# ---------------- Structure Input ----------------
read_data       data-template.lmp      # Read initial structure


# ---------------- Atom Properties ----------------
# Atomic masses in amu
mass 1 18.9984   # F → Fluorine
mass 2 1.0079    # H → Hydrogen
mass 3 12.0107   # C → Carbon
mass 4 14.0067   # N → Nitrogen


# ---------------- Bond Parameters ----------------
# Bond coefficients must be set AFTER the simulation box is defined
bond_coeff      2  0.0 1.1025    # CH3: bond type 2


# ---------------- Pair Potential ----------------
pair_style      deepmd frozen-model.pth  # DeepMD model
pair_coeff      * *  F H C N  # Map LAMMPS atom types to element names


# ---------------- Neighbor List ----------------
neighbor        0.5 bin                    # Neighbor skin distance = 0.5 Å
neigh_modify    delay 0 every 1 check yes  # Rebuild neighbor list every step if needed


# ---------------- Energy Minimization (optional) ----------------
#min_style cg
#minimize 1e-6 1e-8 10000 100000  # (tol: energy 1e-6, force 1e-8, max 10000 steps/100000 evals)


# ---------------- MD Settings ----------------
timestep        0.0003    # Integration time step = 0.0003 ps = 0.3 fs

thermo          100       # Thermodynamic output every 100 steps
thermo_style    custom step pe ke etotal temp press

# Initialize velocities at 298.15 K if no velocity distribution is present
#velocity all create 298.15 12345 mom yes rot yes dist gaussian
# - 12345 = random seed
# - mom yes = zero total momentum
# - rot yes = zero total angular momentum
# - dist gaussian = Maxwell-Boltzmann distribution


# ---------------- Trajectory Output ----------------
dump            traj all custom 1 traj.lammpstrj id type x y z vx vy vz fx fy fz
dump_modify     traj sort id


# ---------------- NVT / NVE Molecular Dynamics ----------------
#fix             1 all nvt temp 298.15 298.15 0.1
# Nose–Hoover thermostat:
# - start T = 298.15 K, target T = 298.15 K
# - damping parameter = 0.1 ps

fix             1 all nve

# Optional SHAKE/RATTLE for constrained bonds
fix             2 all rattle 1.0e-4 20 1000 b 2


# Run length
run             10000


# ---------------- Output Final Configuration ----------------
write_restart   lmp.restart
write_data      lmp.data

